# v1 (simulation mode) needs no keys. Nothing in this file is read yet.
#
# For v2/v3, keys belong in a local backend, never in VITE_* variables:
# anything prefixed VITE_ is bundled into the browser and visible to anyone.
#
# Optional: fix the seed so every session is reproducible (blank = random).
VITE_SIM_SEED=
