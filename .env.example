# v1 (simulation mode) needs no keys. Nothing in this file is read yet.
#
# For v2/v3, keys belong in a local backend, never in VITE_* variables:
# anything prefixed VITE_ is bundled into the browser and visible to anyone.
#
# Optional: fix the seed so every session is reproducible (blank = random).
VITE_SIM_SEED=

# Live data mode (read-only). Optional: a Solana RPC endpoint. Default is the
# public mainnet endpoint, which is rate-limited. A provider URL that contains an
# API key is visible to anyone using the page, so use a key restricted to your domain.
VITE_SOLANA_RPC_URL=

# Optional: a card/Apple Pay on-ramp link shown in "Add funds". {address} is
# replaced by the connected wallet address. Use a URL your provider gives you.
VITE_ONRAMP_URL_TEMPLATE=
VITE_ONRAMP_NAME=
