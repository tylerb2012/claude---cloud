{
  "name": "multi-venue-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "batch": "tsx scripts/batch.ts",
    "build:paper": "vite build -c vite.paper.config.ts && node scripts/build-paper.mjs",
    "build:desk": "node scripts/build-desk.mjs",
    "forward": "node forward/run.mjs",
    "lab-data": "node forward/build-lab-data.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "stream-json": "^1.9.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
